# claude-deck configuration.
#
# Copy to `.env` in the repo root and edit. The server loads this file at
# startup; anything already exported in your shell wins over it. Every setting
# has a working default — an empty `.env` monitors local Claude Code sessions
# out of the box, and each optional feature switches itself on only once you
# configure it.
#
# Settings that are a *list* (launchers, workflow phases) live in
# `claude-deck.config.json` instead, because an environment variable cannot
# express one without inventing an encoding nobody can read. See
# `examples/claude-deck.config.json`.
#
# Several variables were originally named after Jira, Docker or a particular
# VM. Those names still work — the neutral name is listed first, with the
# original noted beside it — so an existing `.env` needs no migration.

# --- Core --------------------------------------------------------------------

# Port the server (and, in production, the bundled UI) listens on.
#PORT=3456

# Interface to bind. Loopback by default (every loopback address, IPv4 and IPv6):
# this API has no authentication, and it can read every transcript on the machine
# and type into live sessions. Set 0.0.0.0 only to reach the dashboard from
# another device on a trusted network.
#HOST=localhost

# Where Claude Code keeps its transcripts. Change only if yours is elsewhere.
#CLAUDE_DIR=~/.claude

# Path to the config file, if you keep it somewhere other than the repo root or
# the working directory.
#CLAUDE_DECK_CONFIG=~/.config/claude-deck.json

# Claude Code's own registry of running sessions — one <pid>.json per session,
# carrying its session id, name, working directory and busy/idle status. This is
# how the "Live" filter and the session names work. It is an undocumented
# internal of Claude Code, so a missing directory just means less detail;
# nothing is hidden because an entry didn't appear.
#CLAUDE_SESSIONS_DIR=~/.claude/sessions

# How often local sessions, processes, containers and tmux are rescanned.
#SCAN_INTERVAL_MS=5000

# Sessions older than this are dropped from the dashboard.
#MAX_SESSION_AGE_DAYS=1

# Prefilled in the "New session" dialog — the repo you start sessions in most
# often. Defaults to your home directory.
#SPAWN_DEFAULT_CWD=~/code/my-repo

# Shell used to launch a session, so `claude` resolves the way it does in your
# terminal (it is often a shell function that injects a token, not a binary).
#SPAWN_SHELL=/bin/zsh

# tmux session name prefix for sessions claude-deck launches itself. Keep it
# distinct from TMUX_PREFIX so these names never produce a tag.
#SPAWN_TMUX_PREFIX=cm-

# --- Tags --------------------------------------------------------------------
#
# A tag is the short identifier a session belongs to — the thing that ties a
# container's name, a session's opening prompt and a tracker item together. The
# default is a Jira/Linear-style key.

# Regular expression matching one tag (no anchors, no flags). Everything follows
# it: container matching, the tab label, the launch dialog's paste parser, and
# the tracker lookup.
#TAG_PATTERN=[A-Z][A-Z0-9]+-\d+
#TAG_PATTERN=#\d+                  # GitHub issues, say

# Prefilled in the launch dialog's input, so the project you work in most is one
# keystroke away. Cosmetic — any valid tag can still be typed.
# (was JIRA_ISSUE_PREFIX)
#TAG_PREFIX=PROJ-

# --- Agent containers --------------------------------------------------------
#
# claude-deck discovers, reads and drives containers whose name starts with the
# prefix below, however they were started. It needs one thing from a container:
# Claude running under tmux in session CONTAINER_TMUX_SESSION, window 0, pane 0.

# Turn container scanning off entirely. (was DOCKER_ENABLED)
#CONTAINERS_ENABLED=false

# The blast radius of every container operation here — scanning, reading,
# sending keystrokes, removing. Keep it specific. (was DOCKER_PREFIX)
#CONTAINER_PREFIX=jira-agent-

# The tmux session Claude runs under *inside* a container.
#CONTAINER_TMUX_SESSION=agent

# Where Claude Code writes its transcripts inside a container.
#CONTAINER_CLAUDE_PROJECTS_DIR=/home/agent/.claude/projects

# Prefix of host tmux sessions that are working on a tag.
#TMUX_PREFIX=jira-

# Turn tmux scanning off.
#TMUX_ENABLED=false

# --- Launching ---------------------------------------------------------------
#
# For more than one launcher, or a launcher that isn't shaped like
# `<script> <TAG>`, define `launchers` in claude-deck.config.json instead. These
# two variables are a shorthand that produces the same list.

# Your script that starts work on a tag, run as `<script> <TAG>` inside a
# detached tmux session. Unset means no local launcher.
# (was JIRA_RESOLVE_SCRIPT)
#LAUNCH_SCRIPT=~/code/my-repo/docker/start-agent.sh

# --- Tracker -----------------------------------------------------------------
#
# Optional. Without credentials the work-item badges are simply absent; nothing
# else changes. Resolved per field, in this order: JIRA_*, then ATLASSIAN_*,
# then an MCP server entry in ~/.claude.json.

#JIRA_BASE_URL=https://your-site.atlassian.net
#JIRA_EMAIL=you@example.com
#JIRA_API_TOKEN=...

# Which `mcpServers` entry in ~/.claude.json to read credentials from. Empty
# means "any entry that carries ATLASSIAN_* keys".
#JIRA_MCP_SERVER=atlassian

# --- Workflow artifacts ------------------------------------------------------

# Directory of per-item artifacts written by your own agent workflow, one
# subdirectory per tag. The Workflow page also needs a `workflow` block in
# claude-deck.config.json describing what those files mean — with only one of
# the two configured, the page stays off. (was SESSIONS_DIR)
#ARTIFACTS_DIR=~/code/my-repo/sessions

# --- Remote host -------------------------------------------------------------
#
# The same agent containers running on another machine, reached entirely through
# a script of yours. claude-deck owns no part of that contract: not the
# instance, the tunnel, the image, nor the secrets. The script must accept
# `list`, `start <TAG>`, `shell <TAG> <command…>` and `rm <TAG> -f`.
# Remote support is off unless the script is set.

# (was VM_RESOLVE_SCRIPT)
#REMOTE_SCRIPT=~/code/my-repo/docker/agent-on-vm.sh

# Turn remote support off while keeping the script configured.
# (was VM_ENABLED)
#REMOTE_ENABLED=false

# Instance targeting, forwarded to your script as AGENT_VM_* on every call.
# Each is passed only when set, so the script's own defaults otherwise apply.
#AGENT_VM_NAME=my-agent-vm
#AGENT_VM_ZONE=us-central1-a
#AGENT_VM_PROJECT=my-project

# How often remote containers are rediscovered. Deliberately much slower than
# the local loop: each read is a full round trip.
#VM_SCAN_INTERVAL_MS=30000

# How fast the UI polls the terminal for a remote session. Faster than the local
# default because streamed frames are served from the server's memory.
#REMOTE_CAPTURE_POLL_MS=500

# --- Remote transport tuning -------------------------------------------------
#
# Four measured latency mitigations that take a remote keystroke from ~10s to
# ~0.5s. Each can be switched off independently to bisect a transport problem;
# with all of them off everything still works, just slowly. These are specific
# to the ssh/gcloud transport, which is why they keep the VM_ prefix.

#VM_SSH_MUX=false                  # reuse one ssh connection across calls
#VM_FAST_EXEC=false                # replay the connection the script opened
#VM_CHANNEL=false                  # persistent command channel per session
#VM_STREAM=false                   # long-lived capture stream

# The remote command your script runs on the far side. The fast path only ever
# replays commands aimed at this, so a recording that isn't what we think it is
# can't be reused.
#VM_RUNNER_SCRIPT=vm-resolve-runner.sh

# Pause between pasting a message and pressing Enter. Raise it if a message ever
# needs a second Enter.
#VM_PASTE_SETTLE_SECONDS=0.25

# Price remote subagents by pulling their transcripts over the tunnel —
# accurate, much slower.
#VM_SUBAGENT_COSTS=true

# Remaining timing knobs, all with working defaults:
#VM_STATE_TTL_MS=15000
#VM_CAPTURE_TTL_MS=2500
#VM_SSH_MUX_PERSIST_SECONDS=600
#VM_STREAM_INTERVAL_SECONDS=0.4
#VM_STREAM_MAX_FRAMES=900
#VM_STREAM_IDLE_MS=30000
#VM_STREAM_STALE_MS=15000
#VM_CHANNEL_IDLE_MS=120000
#VM_SUBAGENT_BYTE_BUDGET=8388608
